# Eduvia repository-wide ignore rules.
#
# A single root file covers both apps: patterns without a leading slash apply at
# every depth, so `frontend/` and `backend/` inherit everything below. Anchored
# `/backend/...` entries are runtime output directories whose exact location is
# configured in the backend, not committed here.

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo
.vite/
vite.config.ts.timestamp-*

# Test and tooling caches
coverage/
.nyc_output/
.eslintcache
.prettiercache

# Environment and secrets
# Real credentials never enter the repository. The example and test fixtures are
# committed on purpose so tests pass without any local `.env` present.
.env
.env.*
!.env.example
!.env.test
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime user content
# Uploads, generated DOCX previews, and local storage copies are written at
# runtime and never committed. `backend/src/storage/` is source code, so these
# paths are anchored to the backend root rather than left unanchored.
/backend/tmp/
/backend/.tmp/
/backend/temp/
/backend/uploads/
/backend/storage/
/backend/previews/
*.tmp

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
.history/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
._*

# Patch and merge leftovers
*.orig
*.rej
