# Copy to .env and fill in. .env is gitignored; this template is committed.
# VITE_* values are bundled into the browser: never put a secret here.

# Supabase project URL.
# Local stack: http://127.0.0.1:54321
# Hosted: https://<project-ref>.supabase.co (no trailing slash)
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy anon JWT.
VITE_SUPABASE_ANON_KEY=

# Express API base URL. The local backend listens on http://localhost:4000.
VITE_API_URL=
