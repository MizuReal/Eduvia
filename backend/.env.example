# Copy to .env and fill in. .env is gitignored; this template is committed.
# The service-role/secret key bypasses RLS: backend only, never client-side.

# development | test | production
NODE_ENV=

# Express listener port. frontend/.env VITE_API_URL must point here.
PORT=

# Comma-separated exact origins. Wildcards are forbidden in production.
CORS_ALLOWED_ORIGINS=

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=

# Supabase project URL.
# Local stack: http://127.0.0.1:54321
# Hosted: https://<project-ref>.supabase.co (no trailing slash)
SUPABASE_URL=

# Secret key (sb_secret_...) or the legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: legacy HS256 projects only. Leave unset with JWT signing keys;
# the backend then verifies through JWKS derived from SUPABASE_URL.
# SUPABASE_JWT_SECRET=
