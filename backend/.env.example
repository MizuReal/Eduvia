# Copy to .env and fill in. .env is gitignored; this template is committed.
# The service-role/secret key bypasses RLS: backend only, never client-side.

# development | test | production
NODE_ENV=

# Express listener port. frontend/.env VITE_API_URL must point here.
PORT=

# Comma-separated exact origins. Wildcards are forbidden in production.
CORS_ALLOWED_ORIGINS=

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=

# Supabase project URL.
# Local stack: http://127.0.0.1:54321
# Hosted: https://<project-ref>.supabase.co (no trailing slash)
SUPABASE_URL=

# Secret key (sb_secret_...) or the legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: legacy HS256 projects only. Leave unset with JWT signing keys;
# the backend then verifies through JWKS derived from SUPABASE_URL.
# SUPABASE_JWT_SECRET=

# Optional: required only for teacher self-registration. Use at least 16
# characters. Leave unset to disable teacher self-registration.
# TEACHER_REGISTRATION_CODE=

# Optional upload/storage tuning. Defaults shown; leave unset to use them.
# UPLOAD_TEMP_DIR=/tmp/eduvia-uploads
# DOCUMENT_MAX_BYTES=26214400
# IMAGE_MAX_BYTES=10485760
# IMAGE_MAX_PIXELS=40000000
# USER_STORAGE_QUOTA_BYTES=262144000
# SIGNED_URL_TTL_SECONDS=300
# UPLOAD_RATE_LIMIT_WINDOW_MS=900000
# UPLOAD_RATE_LIMIT_MAX=30
